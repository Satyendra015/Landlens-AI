# LandLens AI — Environment Configuration
PROJECT_NAME="LandLens AI"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (SQLite default for zero-config; can use postgresql://user:pass@localhost:5432/landlens)
DATABASE_URL="sqlite:///./landlens.db"

# Security & JWT Auth
SECRET_KEY="landlens-secret-key-change-in-production-for-sih26018"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Upload Storage Directory
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15

# Confidence Score Thresholds
CONFIDENCE_HIGH_THRESHOLD=0.90
CONFIDENCE_MEDIUM_THRESHOLD=0.70

# Fuzzy Duplicate Threshold (0.0 - 1.0)
DUPLICATE_SIMILARITY_THRESHOLD=0.75

# Port
PORT=8000
HOST="0.0.0.0"
